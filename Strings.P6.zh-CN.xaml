<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:s="clr-namespace:System;assembly=System.Runtime">
 <s:String x:Key="GoalNew">新建周目标</s:String><s:String x:Key="GoalEdit">编辑周目标</s:String><s:String x:Key="GoalKind">目标类型</s:String><s:String x:Key="GoalCount">数量</s:String><s:String x:Key="GoalDuration">累计实际时长</s:String><s:String x:Key="GoalCheck">勾选</s:String>
 <s:String x:Key="GoalSource">自动统计来源（只选一种）</s:String><s:String x:Key="GoalNone">无自动来源</s:String><s:String x:Key="GoalTodo">待办完成数量</s:String><s:String x:Key="GoalActivity">实际日程</s:String><s:String x:Key="GoalTarget">目标值（时长填小时；勾选固定1）</s:String><s:String x:Key="GoalUnit">数量单位</s:String>
 <s:String x:Key="GoalOverride">手动覆盖（留空恢复自动；时长填小时）</s:String><s:String x:Key="GoalAutomatic">自动</s:String><s:String x:Key="GoalManual">手动覆盖</s:String><s:String x:Key="GoalRestore">恢复自动统计</s:String><s:String x:Key="GoalLinks">关联对象（可多选；仅选定来源参与统计）</s:String>
 <s:String x:Key="GoalInvalid">目标值须大于0，覆盖值须非负；勾选只能0或1；实际时长不能使用待办来源。</s:String><s:String x:Key="GoalChangeConfirm">改变目标类型或统计来源将改变自动进度含义，已有关联保留。确认保存？</s:String><s:String x:Key="GoalDelete">删除周目标</s:String><s:String x:Key="GoalDeleteConfirm">只删除此目标，保留待办、日程和周总结。可撤销。</s:String>
 <s:String x:Key="GoalOutside">包含跨周待办：数量按全部显式关联的完成项计算，请检查日期。</s:String><s:String x:Key="GoalEmpty">本周暂无目标</s:String><s:String x:Key="GoalLinkHint">周目标关联仅当前事项/实例，不扩展整个周期系列。新目标独立保存，当前事项保存后才关联。</s:String><s:String x:Key="GoalAllWeeks">显示其他周目标</s:String>
 <s:String x:Key="WeekStatsTitle">本周实际时间</s:String><s:String x:Key="WeekDenominator">占比基准：本周实际自然时长</s:String><s:String x:Key="WeekOverlapHint">同分类合并去重；不同分类分别累计，百分比总和可超过100%。</s:String><s:String x:Key="WeekHours">小时</s:String><s:String x:Key="WeekUncategorized">未分类</s:String><s:String x:Key="WeekGlobal">全局去重</s:String>
 <s:String x:Key="ReviewEdit">编辑周总结</s:String><s:String x:Key="ReviewBody">自由 Markdown 总结</s:String><s:String x:Key="ReviewSections">自定义小节</s:String><s:String x:Key="ReviewAddSection">＋小节</s:String><s:String x:Key="ReviewRemoveSection">移除此节</s:String><s:String x:Key="ReviewInsertStats">插入当前统计摘要</s:String><s:String x:Key="ReviewSnapshots">自动统计快照（独立保存，不覆盖正文）</s:String><s:String x:Key="ReviewPending">未保存快照</s:String><s:String x:Key="ReviewEmpty">本周尚未写总结</s:String><s:String x:Key="ReviewInvalid">小节标题不能为空；请检查备注和本地图片。</s:String>
 <s:String x:Key="WeekStartSetting">每周首日（历史周身份保持不变）</s:String><s:String x:Key="WeekLayoutSetting">月历周计划布局</s:String><s:String x:Key="WeekSide">周右侧窄栏</s:String><s:String x:Key="WeekStrip">每周可展开摘要条</s:String><s:String x:Key="WeekManage">管理本周目标与总结</s:String><s:String x:Key="WeekIdentityHint">历史周按创建时首日和时区保存；改首日不移动旧目标/总结，可切回原设置查看。</s:String>
 <s:String x:Key="ActivityGoal">周目标关联</s:String><s:String x:Key="GoalCheckHint">勾选目标的自动来源表示：至少一个关联对象达到来源条件。需全部完成时请用数量目标。</s:String>
</ResourceDictionary>
