<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>DesktopCalendar</AssemblyName>
    <Version>0.8.4</Version>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>assets\branding\DesktopCalendar.ico</ApplicationIcon>
    <NuGetAudit>false</NuGetAudit>
    <!-- WPF owns the process DPI manifest; WinForms is used only for NotifyIcon/Screen. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <!-- WPF checks share this assembly's internal UI APIs; Core checks are a separate project. -->
  <ItemGroup>
    <ProjectReference Include="Core\DesktopCalendar.Core.csproj" />
    <Resource Include="assets\branding\DesktopCalendar.ico" />
    <Resource Include="assets\branding\logo-64.png" />
    <None Update="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="Core\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Include="tests\WpfChecks\*.cs" />
  </ItemGroup>
</Project>
