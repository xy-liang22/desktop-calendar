<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>DesktopCalendar</AssemblyName>
    <NuGetAudit>false</NuGetAudit>
    <!-- WPF owns the process DPI manifest; WinForms is used only for NotifyIcon/Screen. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <!-- Keep the independently runnable desktop experiment out of the P1 application. -->
  <ItemGroup>
    <Compile Remove="experiments\**\*.cs" />
    <Page Remove="experiments\**\*.xaml" />
    <EmbeddedResource Remove="experiments\**\*" />
    <None Remove="experiments\**\*" />
  </ItemGroup>
</Project>
