<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#202E3B"/>
 <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#EDF2F5"/>
 <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#344F5D"/>
 <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
 <Style TargetType="ContextMenu">
  <Setter Property="Foreground" Value="#EDF2F5"/><Setter Property="Background" Value="#202E3B"/><Setter Property="BorderBrush" Value="#526474"/><Setter Property="HasDropShadow" Value="True"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4"><ScrollViewer CanContentScroll="True" MaxHeight="420"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer></Border></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="MenuItem">
  <Setter Property="Foreground" Value="#EDF2F5"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="8,7"/><Setter Property="FontSize" Value="12"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
   <Grid><Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="Tick" Text="✓" Foreground="{TemplateBinding Foreground}" Visibility="Collapsed"/><ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
    <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="#A2AFBC" Margin="14,0,0,0"/><TextBlock x:Name="Arrow" Grid.Column="3" Text="›" Foreground="{TemplateBinding Foreground}" Visibility="Collapsed"/>
   </Grid></Border>
   <Popup x:Name="PART_Popup" Placement="Right" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False"><Border Background="#202E3B" BorderBrush="#526474" BorderThickness="1" CornerRadius="8" Padding="4"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></Border></Popup></Grid>
   <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#344F5D"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="HasItems" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#94A2AE"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="#3B4B59" Margin="8,4"/></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="DarkToggle" TargetType="ToggleButton">
  <Setter Property="Foreground" Value="#EDF2F5"/><Setter Property="Padding" Value="6,4"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="#526474" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#A3D9C4"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="CalendarCheck" TargetType="CheckBox">
  <Setter Property="Foreground" Value="#A3D9C4"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent" Width="17" Height="16"><Border x:Name="Box" Width="12" Height="12" CornerRadius="3" Background="#263743" BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/><Path x:Name="Mark" Data="M 5,8 L 7,10 L 12,5" Stroke="#EDF2F5" StrokeThickness="1.4" Visibility="Collapsed"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="#40545F"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="ColorSwatch" TargetType="Button">
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" CornerRadius="3" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" Margin="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <!-- Keep the framework date calendar's light template, with scoped readable ink.
      The application-wide TextBlock foreground must not bleed into that template. -->
 <Style TargetType="Calendar">
  <Style.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#17232F"/></Style></Style.Resources>
  <Setter Property="Foreground" Value="#17232F"/><Setter Property="Background" Value="#FFFFFF"/>
 </Style>
 <Style TargetType="DatePicker"><Setter Property="CalendarStyle" Value="{StaticResource {x:Type Calendar}}"/></Style>
</ResourceDictionary>
