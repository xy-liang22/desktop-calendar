<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:s="clr-namespace:System;assembly=System.Runtime">
 <s:String x:Key="AppName">Desktop Calendar</s:String><s:String x:Key="Prototype">P1.1 · 模拟内容原型</s:String>
 <s:String x:Key="MonthTab">月历与今日</s:String><s:String x:Key="WeekTab">一周回顾</s:String>
 <s:String x:Key="Topmost">始终置顶</s:String><s:String x:Key="AutoHide">贴边收起</s:String>
 <s:String x:Key="Opacity">背景透明度</s:String><s:String x:Key="Compact">待办</s:String>
 <s:String x:Key="CompactTip">折叠为今日待办</s:String><s:String x:Key="TrayTip">隐藏到托盘 · 双击托盘图标找回</s:String>
 <s:String x:Key="TodayTodos">今日待办</s:String><s:String x:Key="RestoreFull">展开完整日历</s:String>
